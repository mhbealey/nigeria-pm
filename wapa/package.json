{
  "name": "wapa",
  "version": "0.1.0",
  "description": "WAPA - WhatsApp Project Management Assistant",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^13.0.0",
    "drizzle-orm": "^0.36.0",
    "pg": "^8.13.0",
    "bullmq": "^5.0.0",
    "ioredis": "^5.0.0",
    "@anthropic-ai/sdk": "^0.39.0",
    "zod": "^3.0.0",
    "date-fns": "^4.0.0",
    "@paralleldrive/cuid2": "^2.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "@sentry/node": "^8.0.0"
  },
  "devDependencies": {
    "vitest": "^2.0.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.0",
    "tsx": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "eslint-config-prettier": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "lint-staged": "^15.0.0",
    "husky": "^9.0.0",
    "drizzle-kit": "^0.30.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
